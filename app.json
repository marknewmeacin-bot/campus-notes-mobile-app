{
  "expo": {
    "name": "Campus-notes",
    "slug": "campus-notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./notes-logo.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.campusnotes.mobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./notes-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#f5f7fb"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Campus-notes to select document photos from your gallery.",
          "cameraPermission": "Allow Campus-notes to scan document pages with your camera.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "cb41c7f8-43f5-4810-85fb-f3759bd8687f"
      }
    }
  }
}
